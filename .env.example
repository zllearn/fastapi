# 统一库（MySQL）连接参数。复制为 .env 后填入真实值：cp .env.example .env
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=future_industry_insight

# 站点访问鉴权。用户名/密码任一为空则不启用鉴权（仅限本地调试）。
AUTH_USERNAME=
AUTH_PASSWORD=
# 会话有效期（小时），默认 12
AUTH_TTL_HOURS=12
# 固定会话签名密钥（如 openssl rand -hex 32）；留空则每次启动随机生成，重启后所有会话失效
AUTH_SECRET=
# HTTPS 部署时设为 1，Cookie 仅经加密连接发送
AUTH_COOKIE_SECURE=0

# 访问日志中间件（记录 IP/方法/路径/状态/耗时/字节/UA）。设为 0 关闭（如改用 nginx 日志）
ACCESS_LOG=1

# 位于 nginx 等反向代理之后时设为 1：客户端 IP 取 X-Forwarded-For 首跳，
# 登录失败锁定才能按真实来源分桶。直连/本机调试保持 0（该头可由客户端自报、可伪造）。
TRUST_PROXY_HEADERS=0
