# 服务器生产 .env 模板：复制为项目根目录的 .env 后填值，切勿把填好的文件提交或外发。
#   cp deploy/env.production.example .env
#   chmod 600 .env        # 里面有口令
#
# 生成密钥与强口令：
#   openssl rand -hex 32                       # AUTH_SECRET
#   openssl rand -base64 24                    # 登录口令 / MySQL 口令

# ---- 统一库（MySQL）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=future_industry_insight
# 运行态用只读账号（scripts/mysql_provision_user.sql 里的 fii_runtime）；
# 跑 build.py --rebuild / migrate 时临时换成 fii_build，跑完换回。
MYSQL_USER=fii_runtime
MYSQL_PASSWORD=改成部署时用 openssl 新生成的强口令

# ---- 站点访问鉴权（上线必填，两项任一留空 = 关闭鉴权、放行全部请求）----
# 不要用仓库里演示过的默认口令；公网暴露前务必核对这一行。
AUTH_USERNAME=改成自己的账号
AUTH_PASSWORD=改成自己的强口令
# 会话有效期（小时）：桌面端整天开着标签页可给 12，夜间挂机可给 24
AUTH_TTL_HOURS=12
# 必填！多 worker / 重启后会话要保持有效，必须有固定密钥；留空则每次启动随机生成
AUTH_SECRET=填 openssl rand -hex 32 的输出
# HTTPS 部署设为 1（Cookie 仅经加密连接下发）；纯 HTTP 内网部署保持 0
AUTH_COOKIE_SECURE=1

# ---- 访问日志与反向代理 ----
# 已有 nginx access.log 时可设 0 关掉应用日志
ACCESS_LOG=1
# 位于 nginx 之后必须设为 1：客户端 IP 取 X-Forwarded-For 首跳，
# 否则登录失败锁定会把所有用户记在 127.0.0.1 同一个桶里（一人输错、全员被锁）。
TRUST_PROXY_HEADERS=1
